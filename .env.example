# HC Core — environment variables
# Copy to `.env.local` and fill in. Never commit `.env.local`.

# --- Supabase ---------------------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Anon (publishable) key — safe in the browser, RLS still applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY. Bypasses RLS.
# Only `app/api/v1/**` and `scripts/**` may use it (see lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth -------------------------------------------------------------------
# Office email domain allowed to sign up. The `on_auth_user_created` trigger
# (handle_new_user() in supabase/migrations/0001_init.sql) rejects any other
# domain, so this must match what that function enforces: the
# `app.allowed_email_domain` setting when one is installed (self-managed
# Postgres only — Supabase refuses `alter database … set` with 42501), else
# the literal fallback inside the function, which is what Supabase runs on.
ALLOWED_EMAIL_DOMAIN=hutamakarya.com

# --- Seed awal (scripts/seed-from-excel.ts, sekali jalan) -------------------
# Jalur utama Seed awal adalah halaman /karyawan/seed di aplikasi (PRD #23):
# Excel dibaca di peramban admin, tanpa variabel ini. Skrip di bawah adalah
# alternatif untuk orang teknis dengan komputer ber-Node.
# A DIRECT Postgres connection string, not the PostgREST URL above. The Seed
# needs a real transaction so that ~1.475 Karyawan land in ONE batch `seed`
# that can be reverted whole (ADR-006); supabase-js over HTTP cannot do that.
# On Supabase this is Settings → Database → "Direct connection".
# `lib/revisions/seedBatch.ts` also accepts SUPABASE_DB_URL, DATABASE_URL or
# HC_LOCAL_DB_URL, in that order, if this one is empty.
HC_SEED_DB_URL=

# --- Local verification harness (scripts/db-local.sh) -----------------------
# Only used by the local Postgres 16 test database. Not a production setting.
HC_LOCAL_DB_URL=postgresql://postgres@localhost:5432/hc_core_test
