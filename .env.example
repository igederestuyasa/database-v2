# HC Core — environment variables
# Copy to `.env.local` and fill in. Never commit `.env.local`.

# --- Supabase ---------------------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Anon (publishable) key — safe in the browser, RLS still applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY. Bypasses RLS.
# Only `app/api/v1/**` and `scripts/**` may use it (see lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth -------------------------------------------------------------------
# Office email domain allowed to sign up. The `on_auth_user_created` trigger
# rejects any other domain, so this must match `app.allowed_email_domain`
# configured on the database (see supabase/migrations/0001_init.sql).
ALLOWED_EMAIL_DOMAIN=hutamakarya.com

# --- Local verification harness (scripts/db-local.sh) -----------------------
# Only used by the local Postgres 16 test database. Not a production setting.
HC_LOCAL_DB_URL=postgresql://postgres@localhost:5432/hc_core_test
